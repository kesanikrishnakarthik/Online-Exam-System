# CollegeConnect Environment Configuration Template
# Copy this file to .env or configure in your deployment/CI-CD environment.

# Server Port
SERVER_PORT=8081

# Production PostgreSQL Database Configuration (Used in Docker Compose)
DB_NAME=onlineexamdb
DB_USER=postgres
DB_PASSWORD=change_this_to_a_strong_password_in_production

# Direct JDBC Configuration (Overrides for standalone deployment)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/onlineexamdb
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=change_this_to_a_strong_password_in_production

# Local Development Fallback Database (File-based H2, persists to disk)
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/onlineexamdb;AUTO_SERVER=TRUE;DB_CLOSE_DELAY=-1
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# Platform Super-Administrator Initial Credentials
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SetAStrongPlatformPassword2026!
SUPERADMIN_EMAIL=superadmin@collegeconnect.edu

# Data Seeding & Cleanup Controls
APP_SEED_TEST_DATA=false
APP_CLEAN_DEMO_DATA=false

# Google Firebase Configuration (Web Client SDK)
FIREBASE_PROJECT_ID=online-exams-98fa6
FIREBASE_AUTH_DOMAIN=online-exams-98fa6.firebaseapp.com
FIREBASE_STORAGE_BUCKET=online-exams-98fa6.firebasestorage.app
FIREBASE_APP_ID=1:204869742765:web:22b7939b4a550f40a55624
